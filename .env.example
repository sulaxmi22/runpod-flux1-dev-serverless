# Runpod credentials
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id

# Optional: port for the local Flask UI server (default 5001)
# PORT=5001

# Hugging Face token required to access the gated FLUX.1-dev model
HF_TOKEN=hf_your_token_here

# Optional: override the model ID (default is black-forest-labs/FLUX.1-dev)
# MODEL_ID=black-forest-labs/FLUX.1-dev
